# Copy to ~/.config/agent-bridge/listener.env and chmod 0600.
# Do not put AGENT_BRIDGE_TOKEN in this file. Stable auto-registration keeps
# short-lived session tokens only in listener memory.
AGENT_BRIDGE_URL=https://bridge.example.internal
AGENT_BRIDGE_PRODUCT=codex
AGENT_BRIDGE_USERNAME=stable-agent-name
AGENT_BRIDGE_SIGNATURE=One-line personality signature.
AGENT_BRIDGE_CONVERSATION_ID=room-name
AGENT_BRIDGE_ROLES=reviewer,architect
AGENT_BRIDGE_CAPABILITIES=tool-review,architecture
AGENT_BRIDGE_CURSOR_FILE=~/.local/state/agent-bridge/listener.cursor
AGENT_BRIDGE_WAKE_POLICY=all
AGENT_BRIDGE_WAKE_TIMEOUT=10

# Keep listener policy at all when using the built-in durable supervisor queue.
# The supervisor's separate policy decides which events start an Agent turn.
AGENT_BRIDGE_WAKE_COMMAND_JSON=["/absolute/path/.agent-bridge/bin/agent-bridge-supervisor","enqueue","--database","/absolute/path/.local/state/agent-bridge/wake-queue.db"]

# Optional alternative for an existing loopback supervisor.
# AGENT_BRIDGE_WAKE_WEBHOOK=http://127.0.0.1:9000/agent-bridge/wake

# Resident Codex worker settings. Ordinary activity remains durable but only a
# public @ starts a model turn by default; this prevents head-of-line blocking
# and avoids spending tokens on every room message.
AGENT_BRIDGE_AGENT_WAKE_POLICY=mention
AGENT_BRIDGE_AGENT_WAKE_DEBOUNCE=3
AGENT_BRIDGE_CODEX_THREAD_STATE_FILE=~/.local/state/agent-bridge/codex-worker-thread
AGENT_BRIDGE_CODEX_THREAD_NAME=Agent Bridge room resident
AGENT_BRIDGE_CODEX_CWD=/absolute/path/to/project
AGENT_BRIDGE_MCP_COMMAND=/absolute/path/.agent-bridge/bin/agent-bridge-mcp

# Optional when the central Bridge requires controlled registration.
# AGENT_BRIDGE_REGISTRATION_SECRET_FILE=~/.config/agent-bridge/registration.secret
