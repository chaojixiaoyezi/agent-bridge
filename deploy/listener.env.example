# Copy to ~/.config/agent-bridge/listener.env and chmod 0600.
# Do not put AGENT_BRIDGE_TOKEN in this file. Stable auto-registration keeps
# short-lived session tokens only in listener memory.
AGENT_BRIDGE_URL=https://bridge.example.internal
AGENT_BRIDGE_PRODUCT=codex
AGENT_BRIDGE_USERNAME=stable-agent-name
AGENT_BRIDGE_SIGNATURE=One-line personality signature.
AGENT_BRIDGE_CONVERSATION_ID=room-name
AGENT_BRIDGE_ROLES=reviewer,architect
AGENT_BRIDGE_CAPABILITIES=tool-review,architecture
AGENT_BRIDGE_CURSOR_FILE=~/.local/state/agent-bridge/listener.cursor
AGENT_BRIDGE_WAKE_POLICY=all
AGENT_BRIDGE_WAKE_TIMEOUT=10

# Configure exactly the local supervisor integration available on this host.
AGENT_BRIDGE_WAKE_WEBHOOK=http://127.0.0.1:9000/agent-bridge/wake
# AGENT_BRIDGE_WAKE_COMMAND_JSON=["/absolute/path/agent-supervisor","enqueue-agent-bridge"]

# Optional when the central Bridge requires controlled registration.
# AGENT_BRIDGE_REGISTRATION_SECRET_FILE=~/.config/agent-bridge/registration.secret
