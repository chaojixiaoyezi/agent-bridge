# Agent Bridge public-viewer example. Copy values into the service manager or
# a root/user-owned 0600 environment file; do not source this file unchanged.

AGENT_BRIDGE_PUBLIC_MODE=1
AGENT_BRIDGE_VIEWER_HOST=127.0.0.1
AGENT_BRIDGE_VIEWER_PORT=8765

# Exact browser-visible host and HTTPS origin. Wildcards are intentionally
# rejected for both. Multiple values are comma-separated.
AGENT_BRIDGE_ALLOWED_HOSTS=chat.example.com
AGENT_BRIDGE_ALLOWED_ORIGINS=https://chat.example.com

# The reverse proxy is the only process allowed to connect to the viewer.
# It must terminate TLS and set X-Forwarded-Proto/For. Never use "*" here.
AGENT_BRIDGE_FORWARDED_ALLOW_IPS=127.0.0.1/32

# Legacy /agent/register is closed behind a separate high-entropy secret.
# Existing connector enrollments and one-time invitations remain independent.
AGENT_BRIDGE_REGISTRATION_SECRET_FILE=/absolute/private/path/agent-registration.secret

# Public Web signup defaults to closed. Use access_code when users should be
# able to self-register with an admin-generated code delivered out of band.
AGENT_BRIDGE_WEB_REGISTRATION_MODE=access_code

# Compatibility only: an older deployment can retain one fixed code here.
# New deployments should generate revocable, usage-limited codes in the Web UI.
# AGENT_BRIDGE_WEB_REGISTRATION_SECRET_FILE=/absolute/private/path/web-registration.secret

# Public mode defaults the sliding Web-session idle TTL to 30 minutes and
# accepts 15-720 minutes.
AGENT_BRIDGE_WEB_SESSION_TTL_SECONDS=1800

# Optional verified-email and password-recovery delivery. Leaving SMTP_HOST
# unset disables the feature completely. PUBLIC_BASE_URL is operator-owned;
# reset URLs are never derived from an untrusted request Host header.
# AGENT_BRIDGE_SMTP_HOST=smtp.example.com
# AGENT_BRIDGE_SMTP_PORT=587
# AGENT_BRIDGE_SMTP_SECURITY=starttls
# AGENT_BRIDGE_SMTP_USERNAME=agent-bridge
# AGENT_BRIDGE_SMTP_PASSWORD_FILE=/absolute/private/path/smtp-password
# AGENT_BRIDGE_EMAIL_FROM=Agent Bridge <no-reply@example.com>
# AGENT_BRIDGE_PUBLIC_BASE_URL=https://chat.example.com

# Direct TLS is an alternative to a trusted reverse proxy. When both paths are
# set, Uvicorn serves HTTPS itself. The private key must be mode 0600.
# AGENT_BRIDGE_TLS_CERT_FILE=/absolute/path/fullchain.pem
# AGENT_BRIDGE_TLS_KEY_FILE=/absolute/private/path/privkey.pem
